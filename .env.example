# Set these in Vercel > Project > Settings > Environment Variables.
# Use a Resend sending-access key restricted to your verified domain.
RESEND_API_KEY=
# Replace with an address at YOUR verified domain. Proton/Gmail are recipients.
RESEND_FROM="Prism <hello@your-verified-domain.com>"

# Optional: turns on Claude AI mode in Effect (/effect/studio). Server-only.
ANTHROPIC_API_KEY=
# Optional overrides for the Focus models and generations per IP per 10 minutes.
EFFECT_MODEL_ASTROLABE=claude-opus-5-5
EFFECT_MODEL_COMPASS=claude-sonnet-5-5
EFFECT_MODEL_SPYGLASS=claude-haiku-5-5
EFFECT_RATE_LIMIT=12
